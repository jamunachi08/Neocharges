  },
  {
   "fieldname": "percentage_on",
   "fieldtype": "Select",
   "options": "\nNet Total\nGrand Total\nTotal Taxes and Charges",
   "label": "Percentage On",
   "depends_on": "eval:doc.charge_basis=='Percentage'",
   "mandatory_depends_on": "eval:doc.charge_basis=='Percentage'",
