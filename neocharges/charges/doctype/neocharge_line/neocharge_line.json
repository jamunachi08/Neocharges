  },
  {
   "fieldname": "charge_currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "in_list_view": 1,
   "columns": 1,
   "description": "Defaults to company currency. Percentage lines use the document currency."
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "columns": 2,
   "label": "Amount",
