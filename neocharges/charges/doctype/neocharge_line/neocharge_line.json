  },
  {
   "fieldname": "vat_direction",
   "fieldtype": "Select",
   "label": "VAT Direction",
   "options": "\nInput VAT\nOutput VAT",
   "depends_on": "eval:doc.vat_treatment && doc.vat_treatment!=\"No VAT\" && doc.apply_to!=\"Invoice Line\"",
   "description": "Input VAT: a charge the company pays (recoverable). Output VAT: a charge billed to the customer. Defaults from the document."
  },
  {
   "fieldname": "vat_account",
   "fieldtype": "Link",
   "label": "VAT Account",
   "options": "Account",
