   "options": "charge_currency"
  },
  {
   "fieldname": "exchange_rate",
   "fieldtype": "Float",
   "label": "Exchange Rate",
   "precision": "9",
   "description": "Line currency to company currency. Lines in company or document currency set this automatically."
  },
  {
   "fieldname": "base_amount",
   "fieldtype": "Currency",
   "label": "Amount incl. VAT (Company Currency)",
   "options": "Company:company:default_currency",
   "read_only": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "section_vat",
   "fieldtype": "Section Break",
   "label": "VAT",
   "collapsible": 1,
   "collapsible_depends_on": "eval:doc.vat_treatment && doc.vat_treatment!=\"No VAT\""
  },
  {
   "fieldname": "vat_treatment",
   "fieldtype": "Select",
   "label": "VAT",
   "options": "No VAT\nVAT Exclusive\nVAT Inclusive",
   "default": "No VAT",
   "in_list_view": 1,
   "columns": 1,
   "description": "Exclusive: VAT is added to the amount. Inclusive: the amount already contains VAT."
  },
  {
   "fieldname": "vat_rate",
   "fieldtype": "Percent",
   "label": "VAT Rate",
   "depends_on": "eval:doc.vat_treatment && doc.vat_treatment!=\"No VAT\"",
